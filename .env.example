# Database
DATABASE_URL=postgresql+asyncpg://ticket_user:ticket_pass@localhost:5432/ticket_intelligence
DATABASE_URL_SYNC=postgresql://ticket_user:ticket_pass@localhost:5432/ticket_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Application
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production

# External APIs
TICKETMASTER_API_KEY=your-ticketmaster-api-key
SONGKICK_API_KEY=your-songkick-api-key

# Rate limiting
RATE_LIMIT_PER_MINUTE=30